{
  "name": "movian7-jellyfin",
  "version": "1.1.4",
  "description": "Modern Jellyfin client for Movian (PlayStation 3) - hardened for Jellyfin 10.9-10.11+, strict PS3 device profile, HLS transcoding.",
  "keywords": [
    "swc",
    "movian",
    "jellyfin",
    "playstation-3",
    "javascript",
    "eslint",
    "prettier"
  ],
  "author": "Louis Biagio Marotta <loumb31@gmail.com>",
  "license": "GPL-3.0-only",
  "main": "jellyfin.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FloStyle/m7-jellyfin.git"
  },
  "homepage": "https://github.com/FloStyle/m7-jellyfin#readme",
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "swc src -d dist && node ./bin/build.js",
    "dev": "npm run build && node ./bin/dev.js",
    "lint": "eslint ./src",
    "format": "prettier --write src/ bin/",
    "format:check": "prettier --check src/ bin/"
  },
  "devDependencies": {
    "@guarapi/eslint-config-guarapi": "^0.1.3",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.10",
    "@swc-node/register": "^1.8.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "archiver": "^7.0.1"
  },
  "movian": {
    "title": "Jellyfin",
    "apiversion": 2,
    "icon": "assets/logo.png",
    "synopsis": "View your personal Jellyfin library",
    "showtimeVersion": "5.0.462",
    "type": "ecmascript",
    "id": "jellyfin",
    "category": "video",
    "control": {}
  }
}
